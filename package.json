{
  "name": "Excilidraw",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --filter \"./apps/**\" --parallel --stream run dev",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm -r --if-present run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
